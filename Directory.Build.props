<?xml version="1.0" encoding="utf-8"?>
<!--
  Directory.Build.props — shared MSBuild properties for all MangaPlex projects.
  Imported automatically by every .csproj in the repository tree.
-->
<Project>
  <Import Project="$(MSBuildThisFileDirectory)Version.props" />

  <PropertyGroup>
    <!-- Root namespace: com.lifepixer.mangaplex (exact match required across all projects) -->
    <RootNamespace>com.lifepixer.mangaplex</RootNamespace>

    <!-- Standard project metadata -->
    <Product>MangaPlex</Product>
    <Company />
    <Authors>Smit Dixit</Authors>
    <Copyright>Copyright (c) 2026 Smit Dixit</Copyright>
    <Description>Folder-native comic/manga server and Angular reader.</Description>

    <!-- Version propagation from Version.props -->
    <Version>$(MangaPlexVersionFull)</Version>
    <PackageVersion>$(MangaPlexVersionFull)</PackageVersion>
    <AssemblyVersion>$(MangaPlexAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(MangaPlexVersionMajor).$(MangaPlexVersionMinor).$(MangaPlexVersionPatch).$(MangaPlexBuildCounter)</FileVersion>

    <!-- InformationalVersion includes full SemVer plus commit SHA and dirty marker.
         Populated by the build script when GitCommitShort is available. -->
    <InformationalVersion Condition="'$(GitCommitShort)' != '' And '$(GitIsDirty)' == 'true'">$(MangaPlexVersionFull)+sha.$(GitCommitShort).dirty</InformationalVersion>
    <InformationalVersion Condition="'$(GitCommitShort)' != '' And '$(GitIsDirty)' != 'true'">$(MangaPlexVersionFull)+sha.$(GitCommitShort)</InformationalVersion>
    <InformationalVersion Condition="'$(GitCommitShort)' == ''">$(MangaPlexVersionFull)+dirty</InformationalVersion>

    <!-- Deterministic builds — no host paths, usernames, or hostnames in output -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Target framework: .NET 10 LTS -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Treat warnings as errors for first-party code -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors)</WarningsNotAsErrors>

    <!-- XML doc generation is off until the public API surface is finalized -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- No auto-generated NuGet packages for local builds -->
    <IsPackable>false</IsPackable>

    <!-- Embed source files in PDB for debugging without exposing host paths -->
    <EmbedAllSources>true</EmbedAllSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Project-specific namespace overrides -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('MangaPixer.Server'))">
    <RootNamespace>com.lifepixer.mangaplex.Server</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('MangaPixer.Core'))">
    <RootNamespace>com.lifepixer.mangaplex.Core</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('MangaPixer.MediaWorker'))">
    <RootNamespace>com.lifepixer.mangaplex.MediaWorker</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <RootNamespace>com.lifepixer.mangaplex.Tests.$(MSBuildProjectName.Replace('MangaPixer.', '').Replace('.Tests', ''))</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MangaPixer.TestSupport'">
    <RootNamespace>com.lifepixer.mangaplex.TestSupport</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
