<?xml version="1.0" encoding="utf-8"?>
<!--
  Version.props — single source of truth for MangaPlex product version.
  Consumed by Directory.Build.props. Angular reads generated build info from the same source.
  SemVer 2.0.0: https://semver.org/
-->
<Project>
  <PropertyGroup>
    <!-- 1.1.0 — first post-1.0 minor. Backward-compatible additive work on top of
         1.0.0: the reader UX package (fit-screen, double-page/offset/wide-page modes,
         immersive fullscreen chrome + help overlay, webtoon placeholders, auto-advance),
         admin runtime log-level control (new /operations/logging endpoints), and the
         EF Core migrations infrastructure that replaces EnsureCreated. No breaking API
         or contract changes, so MINOR per SemVer 2.0.0.
         (1.0.0 was the first stable MVP release; the 0.1.0-dev.N line dev.0…dev.41 was
         the pre-1.0 development series.) -->
    <!-- 1.2.0 — released 2026-09-09 after owner acceptance testing on the real
         Unraid library (rc.1 → rc.4). Backward-compatible additive minor over 1.1.0:
         per-library/folder reading direction, sticky read-marks + bulk/selection UX,
         continue-reading management (dismiss + auto-hide read), Grid/List/Poster view
         modes, previous-chapter auto-advance, interactive progress-rail jump, rotating
         DB backups, YACReader progress import, persistent thumbnails, and scan-safe
         concurrency (private SQLite cache + startup analysis resume). No breaking API
         or contract changes → MINOR per SemVer 2.0.0. Bugfixes ship as 1.2.x. -->
    <!-- 1.3.0 — backward-compatible additive minor over 1.2.0 (post-1.2.0 cycle,
         2026-09-09). Library rename + metadata-only delete (transactional cleanup),
         browse sort (Name / Recently-added / Recently-read), continuous background
         thumbnail backfill (replaces the 500-item startup cap), per-device +
         orientation-aware default reader page mode, client-side page prefetch
         (paged/spread, ahead-6/behind-2), and search-result cover thumbnails. No
         schema change (sort reuses the existing LibrarySort column) and no breaking
         API/contract changes → MINOR per SemVer 2.0.0. Bugfixes ship as 1.3.x. -->
    <!-- 1.4.0 - additive minor over 1.3.0 (post-1.3.0 cycle, 2026-09-10). Incognito /
         Private libraries (per-user Private flag + migration; server-side
         GetVisibleLibraryIdsAsync chokepoint + X-Incognito header; session-default-ON
         Incognito toggle), Plex-pattern home (library sidebar + grouped continue-reading +
         per-library continue endpoint), webtoon read-ahead prefetch, app-version endpoint +
         footer, multilingual collation jump-navigation, and two browse bugfixes (subfolder-
         only folder cover, clickable root breadcrumb). Additive API only (new endpoints +
         fields), no breaking changes -> MINOR per SemVer 2.0.0. Released 2026-09-10
         after owner acceptance testing on the real Unraid library (rc.1 -> rc.4;
         rc.4 landed the recently-read pure-recency fix). Bugfixes ship as 1.4.x. -->
    <!-- 1.4.1 - PATCH over 1.4.0 (2026-09-10). Build/deploy tooling only, no app
         behavior or API change: the container build now embeds the git commit SHA
         into InformationalVersion (Dockerfile ARG/ENV -> $(GitCommitShort)/
         $(GitIsDirty)) so images report "1.4.1+sha.<short>" instead of the bare
         "+dirty" fallback; the deploy script's old-image cleanup no longer sends a
         UTF-8 BOM to the remote shell and the script exits 0 on a healthy deploy. -->
    <!-- 1.5.0 - additive minor over 1.4.1 (post-1.4.1 cycle, 2026-09-11). Five parallel
         feature lanes plus stabilization: worker-throughput tuning (event-driven concurrent
         dispatch + reader-slot reservation + config-bound cap); browse sort ascending/
         descending for every sort; scan speed + content-signature move detection (batch
         reconcile writes; preserves reading state across moves); new-user onboarding via a
         one-time activation token; and a UI taste pass (left-edge collapsible sidebar +
         desktop density), later extended during review with a persistent app-shell library
         sidebar, current-folder breadcrumb, and reading-direction badges. Also a concurrency
         fix for the reading-progress upsert (recovers the (UserId,ItemId) unique-index race
         that caused intermittent 500s) and 7z fixture tests that skip when 7z is absent.
         Three additive migrations (activation-token / sort-direction / content-signature);
         no breaking API changes -> MINOR per SemVer 2.0.0. Bugfixes ship as 1.5.x. -->
    <!-- 1.9.0 - additive minor over 1.8.1 (post-1.8.1 cycle, 2026-09-12). Read-state
         consistency + resume-position option: single-item/multi-select "unread" now fully
         resets (shared reset primitive, consistent with folder-unread); new
         AlwaysOpenReadFromStart preference (default OFF) keys the reader open-page off
         POSITION (last-page -> page 1; mid -> resume unless the option forces page 1), not
         the Completed enum; manual mark-read treated as fully read; per-folder Continue/Start
         label. Plus a configurable reader page-turn animation (Slide/Reveal/None,
         reduced-motion aware) + help-overlay onboarding auto-show, and restored Server.Tests
         parallelism via per-host storage isolation (no global env var). One additive migration
         (AddAlwaysOpenReadFromStart); additive API only (OpenPageIndex, AlwaysOpenReadFromStart)
         -> MINOR per SemVer 2.0.0. Bugfixes ship as 1.9.x. -->
    <!-- 1.9.1 - PATCH over 1.9.0 (2026-09-12), web-only, no API/schema change. Reworks the
         1.9.0 reader page-turn "Reveal" mode: it was a ~0.2s opacity fade that read almost
         identically to "None", so it is now a direction-aware clip-path inset WIPE
         (cover/uncover) - Slide (translate) / Reveal (wipe) / None (instant) are now
         categorically distinct. Also fixes the prefers-reduced-motion override (it was less
         specific than the per-direction rules and did not actually disable the animation;
         now animation:none !important). Owner feedback from the 1.9.0 deploy. -->
    <!-- 1.10.0 - additive minor over 1.9.1 (post-1.9.1 cycle, 2026-09-13). Mobile/UI polish
         from the owner's live iPad + phone use, 3 lanes: (F1) library read-state filter
         (Reading / Read / Unread) at ANY folder level - additive `readState` browse query param
         applied before pagination; (F5) items-per-load moved out of the browse menu into a
         Settings "Performance" card; (F4) app-wide color-highlight for the active menu option
         (browse + reader menus), replacing checkmark ticks; (F2) reader controls consolidated
         into a mobile bottom sheet on phones (Fable-designed - kept Next-chapter + Fullscreen on
         the bar); (F3) mobile library sidebar -> a separate /library-nav page, poster-size slider
         -> submenu, and breadcrumb redesign, all at phone breakpoints. Desktop + iPad layouts
         unchanged (purely responsive, phone-only). Additive API (one browse query param), no
         schema change -> MINOR per SemVer 2.0.0. Bugfixes ship as 1.10.x. Known follow-up: the
         three lanes used slightly different phone breakpoints (560 / 599.98 / 700 px) - harmonize
         later (does not affect phone or iPad, only the 560-700px band). -->
    <!-- 1.10.1 - PATCH over 1.10.0 (2026-09-13), web-only, no API/schema change. Mobile
         library-view polish from live iPad/phone use: (1) the mobile library-nav hamburger is
         now a toggle (second tap closes + returns to origin); (2) breadcrumb current folder
         clamped to two lines with ellipsis on phone (the 1.10.0 redesign ballooned long titles);
         (3) card-size icons swapped from photo_size_select_* (looked like broken images) to
         zoom_out/zoom_in + grid_view; (4) the A-Z jump rail collapses to a letter-picker button
         + menu on phone (it wrapped into an unusable band). All phone-breakpoint-only; desktop +
         iPad unchanged. -->
    <MangaPlexVersionMajor>1</MangaPlexVersionMajor>
    <MangaPlexVersionMinor>10</MangaPlexVersionMinor>
    <MangaPlexVersionPatch>1</MangaPlexVersionPatch>
    <MangaPlexVersionPrerelease></MangaPlexVersionPrerelease>

    <!-- Composed SemVer without build metadata (used for PackageVersion) -->
    <MangaPlexVersion>$(MangaPlexVersionMajor).$(MangaPlexVersionMinor).$(MangaPlexVersionPatch)</MangaPlexVersion>
    <MangaPlexVersionFull Condition="'$(MangaPlexVersionPrerelease)' != ''">$(MangaPlexVersion)-$(MangaPlexVersionPrerelease)</MangaPlexVersionFull>
    <MangaPlexVersionFull Condition="'$(MangaPlexVersionPrerelease)' == ''">$(MangaPlexVersion)</MangaPlexVersionFull>

    <!-- Build counter for FileVersion (numeric only). Defaults to 0 for local builds. -->
    <MangaPlexBuildCounter Condition="'$(MangaPlexBuildCounter)' == ''">0</MangaPlexBuildCounter>

    <!-- AssemblyVersion stays at MAJOR.MINOR.0.0 (1.1.0.0 now) through a minor
         line to avoid binding churn; patch/build vary in FileVersion only. -->
    <MangaPlexAssemblyVersion>$(MangaPlexVersionMajor).$(MangaPlexVersionMinor).0.0</MangaPlexAssemblyVersion>
  </PropertyGroup>
</Project>
