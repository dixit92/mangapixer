<?xml version="1.0" encoding="utf-8"?>
<!--
  Version.props — single source of truth for MangaPixer product version.
  Consumed by Directory.Build.props. Angular reads generated build info from the same source.
  SemVer 2.0.0: https://semver.org/
-->
<Project>
  <PropertyGroup>
    <!-- 1.1.0 — first post-1.0 minor. Backward-compatible additive work on top of
         1.0.0: the reader UX package (fit-screen, double-page/offset/wide-page modes,
         immersive fullscreen chrome + help overlay, webtoon placeholders, auto-advance),
         admin runtime log-level control (new /operations/logging endpoints), and the
         EF Core migrations infrastructure that replaces EnsureCreated. No breaking API
         or contract changes, so MINOR per SemVer 2.0.0.
         (1.0.0 was the first stable MVP release; the 0.1.0-dev.N line dev.0…dev.41 was
         the pre-1.0 development series.) -->
    <!-- 1.2.0 — released 2026-09-09 after owner acceptance testing on the real
         Unraid library (rc.1 → rc.4). Backward-compatible additive minor over 1.1.0:
         per-library/folder reading direction, sticky read-marks + bulk/selection UX,
         continue-reading management (dismiss + auto-hide read), Grid/List/Poster view
         modes, previous-chapter auto-advance, interactive progress-rail jump, rotating
         DB backups, YACReader progress import, persistent thumbnails, and scan-safe
         concurrency (private SQLite cache + startup analysis resume). No breaking API
         or contract changes → MINOR per SemVer 2.0.0. Bugfixes ship as 1.2.x. -->
    <!-- 1.3.0 — backward-compatible additive minor over 1.2.0 (post-1.2.0 cycle,
         2026-09-09). Library rename + metadata-only delete (transactional cleanup),
         browse sort (Name / Recently-added / Recently-read), continuous background
         thumbnail backfill (replaces the 500-item startup cap), per-device +
         orientation-aware default reader page mode, client-side page prefetch
         (paged/spread, ahead-6/behind-2), and search-result cover thumbnails. No
         schema change (sort reuses the existing LibrarySort column) and no breaking
         API/contract changes → MINOR per SemVer 2.0.0. Bugfixes ship as 1.3.x. -->
    <!-- 1.4.0 - additive minor over 1.3.0 (post-1.3.0 cycle, 2026-09-10). Incognito /
         Private libraries (per-user Private flag + migration; server-side
         GetVisibleLibraryIdsAsync chokepoint + X-Incognito header; session-default-ON
         Incognito toggle), Plex-pattern home (library sidebar + grouped continue-reading +
         per-library continue endpoint), webtoon read-ahead prefetch, app-version endpoint +
         footer, multilingual collation jump-navigation, and two browse bugfixes (subfolder-
         only folder cover, clickable root breadcrumb). Additive API only (new endpoints +
         fields), no breaking changes -> MINOR per SemVer 2.0.0. Released 2026-09-10
         after owner acceptance testing on the real Unraid library (rc.1 -> rc.4;
         rc.4 landed the recently-read pure-recency fix). Bugfixes ship as 1.4.x. -->
    <!-- 1.4.1 - PATCH over 1.4.0 (2026-09-10). Build/deploy tooling only, no app
         behavior or API change: the container build now embeds the git commit SHA
         into InformationalVersion (Dockerfile ARG/ENV -> $(GitCommitShort)/
         $(GitIsDirty)) so images report "1.4.1+sha.<short>" instead of the bare
         "+dirty" fallback; the deploy script's old-image cleanup no longer sends a
         UTF-8 BOM to the remote shell and the script exits 0 on a healthy deploy. -->
    <!-- 1.5.0 - additive minor over 1.4.1 (post-1.4.1 cycle, 2026-09-11). Five parallel
         feature lanes plus stabilization: worker-throughput tuning (event-driven concurrent
         dispatch + reader-slot reservation + config-bound cap); browse sort ascending/
         descending for every sort; scan speed + content-signature move detection (batch
         reconcile writes; preserves reading state across moves); new-user onboarding via a
         one-time activation token; and a UI taste pass (left-edge collapsible sidebar +
         desktop density), later extended during review with a persistent app-shell library
         sidebar, current-folder breadcrumb, and reading-direction badges. Also a concurrency
         fix for the reading-progress upsert (recovers the (UserId,ItemId) unique-index race
         that caused intermittent 500s) and 7z fixture tests that skip when 7z is absent.
         Three additive migrations (activation-token / sort-direction / content-signature);
         no breaking API changes -> MINOR per SemVer 2.0.0. Bugfixes ship as 1.5.x. -->
    <!-- 1.9.0 - additive minor over 1.8.1 (post-1.8.1 cycle, 2026-09-12). Read-state
         consistency + resume-position option: single-item/multi-select "unread" now fully
         resets (shared reset primitive, consistent with folder-unread); new
         AlwaysOpenReadFromStart preference (default OFF) keys the reader open-page off
         POSITION (last-page -> page 1; mid -> resume unless the option forces page 1), not
         the Completed enum; manual mark-read treated as fully read; per-folder Continue/Start
         label. Plus a configurable reader page-turn animation (Slide/Reveal/None,
         reduced-motion aware) + help-overlay onboarding auto-show, and restored Server.Tests
         parallelism via per-host storage isolation (no global env var). One additive migration
         (AddAlwaysOpenReadFromStart); additive API only (OpenPageIndex, AlwaysOpenReadFromStart)
         -> MINOR per SemVer 2.0.0. Bugfixes ship as 1.9.x. -->
    <!-- 1.9.1 - PATCH over 1.9.0 (2026-09-12), web-only, no API/schema change. Reworks the
         1.9.0 reader page-turn "Reveal" mode: it was a ~0.2s opacity fade that read almost
         identically to "None", so it is now a direction-aware clip-path inset WIPE
         (cover/uncover) - Slide (translate) / Reveal (wipe) / None (instant) are now
         categorically distinct. Also fixes the prefers-reduced-motion override (it was less
         specific than the per-direction rules and did not actually disable the animation;
         now animation:none !important). Owner feedback from the 1.9.0 deploy. -->
    <!-- 1.10.0 - additive minor over 1.9.1 (post-1.9.1 cycle, 2026-09-13). Mobile/UI polish
         from the owner's live iPad + phone use, 3 lanes: (F1) library read-state filter
         (Reading / Read / Unread) at ANY folder level - additive `readState` browse query param
         applied before pagination; (F5) items-per-load moved out of the browse menu into a
         Settings "Performance" card; (F4) app-wide color-highlight for the active menu option
         (browse + reader menus), replacing checkmark ticks; (F2) reader controls consolidated
         into a mobile bottom sheet on phones (Fable-designed - kept Next-chapter + Fullscreen on
         the bar); (F3) mobile library sidebar -> a separate /library-nav page, poster-size slider
         -> submenu, and breadcrumb redesign, all at phone breakpoints. Desktop + iPad layouts
         unchanged (purely responsive, phone-only). Additive API (one browse query param), no
         schema change -> MINOR per SemVer 2.0.0. Bugfixes ship as 1.10.x. Known follow-up: the
         three lanes used slightly different phone breakpoints (560 / 599.98 / 700 px) - harmonize
         later (does not affect phone or iPad, only the 560-700px band). -->
    <!-- 1.10.1 - PATCH over 1.10.0 (2026-09-13), web-only, no API/schema change. Mobile
         library-view polish from live iPad/phone use: (1) the mobile library-nav hamburger is
         now a toggle (second tap closes + returns to origin); (2) breadcrumb current folder
         clamped to two lines with ellipsis on phone (the 1.10.0 redesign ballooned long titles);
         (3) card-size icons swapped from photo_size_select_* (looked like broken images) to
         zoom_out/zoom_in + grid_view; (4) the A-Z jump rail collapses to a letter-picker button
         + menu on phone (it wrapped into an unusable band). All phone-breakpoint-only; desktop +
         iPad unchanged. -->
    <!-- 1.10.2 - PATCH over 1.10.1 (2026-09-14), web-only, no API/schema change. Continued
         mobile library-view polish from live phone use: (1) the card-size slider moved into the
         View menu on phone, removing the standalone size button (a grid_view icon that duplicated
         the View button's icon and cramped the top bar); desktop/iPad keep the inline toolbar
         slider. (2) Harmonized the phone breakpoint to a single 599.98px (Material XSmall) across
         browse (was 560), reader (already XSmall), and shell/sidebar (was 700). Phone-only;
         desktop + iPad unchanged. -->
    <!-- 1.10.3 - PATCH over 1.10.2 (2026-09-14), web-only, no API/schema change. Two small
         polish items from live desktop use: (1) webtoon page-width slider floor lowered 30% -> 15%
         so the long strip can be zoomed out further on a wide desktop (slider min + the
         setWebtoonWidth/loadWebtoonWidth clamps). (2) the app-shell library sidebar now defaults to
         COLLAPSED when no preference is stored (owner preference); an explicit stored choice is
         still respected and page-mode is unaffected. -->
    <!-- 1.10.4 - PATCH over 1.10.3 (2026-09-14). Recency sorts are now inherently newest-first
         and the ascending/descending toggle is removed for them - it was a misnomer: an ascending
         "Recently added" put the OLDEST item at the top, contradicting the label. Server:
         CatalogBrowseService forces Descending for recentlyAdded/recentlyRead, IGNORING the
         direction param (Name still honors the toggle, default ascending). Web: the Order submenu
         is hidden unless the sort is Name, and selecting a recency sort snaps the stored direction
         to desc. No API surface change (the direction param is simply ignored for recency) and no
         schema change -> PATCH per SemVer 2.0.0. -->
    <!-- 1.11.0 - additive MINOR over 1.10.4 (2026-09-14). UI/UX cycle, 3 parallel lanes: (A) browse
         read-state filter now applies to series FOLDERS by recursive descendant rollup (reusing
         ResolveFolderReadRollupsAsync + FolderReadRollupRules.Classify, composed with keyset paging),
         a new additive `hideEmpty` browse param that hides folders with no archive descendants
         (composes with the read-state filter), and upward/backward infinite-scroll after a jump (new
         additive `before` browse param + PageResponse PrevCursor/HasPrevious, name-sort only); (B)
         reader webtoon tap-zones + swipe (configurable step, free-scroll default preserved), adaptive
         double-page (single in narrow portrait, wide spreads untouched), and a Reveal page-turn wipe
         over a page ghost; (C) a home "New chapters" row grouped by library (new RecentChapters
         endpoint). Additive API only (new browse query params, new PageResponse fields, one new
         endpoint), no schema change -> MINOR per SemVer 2.0.0. Bugfixes ship as 1.11.x. -->
    <!-- 1.12.0 - additive MINOR over 1.11.0 (post-1.11.0 cycle, 2026-09-14). Home-polish cycle
         built on ONE maintained primitive - a per-folder LatestDescendantAddedAt timestamp
         (scan-time bubble-up + migration + one-time backfill) - that powers both a new
         "Recently updated" browse sort (a folder ranks by its newest descendant archive;
         folders + archives interleaved, descending-only) and the home "New chapters" row, now
         STACKED by top-level folder (one card per top-level unit, capped per folder, "latest +
         N new"). Also: reader double-page shows BOTH page numbers (e.g. 12-13); search results
         carry a folder-vs-archive badge; a home card-size slider (shared with the library card
         size) in a top-of-home toolbar; and two per-user settings under Settings > New Chapters
         - which libraries contribute cards, and the "recently added" window in days (replaces
         the hardcoded 30-day window). A home folder-card tap opens that folder with a TRANSIENT
         recentlyUpdated sort (query param, not persisted); selecting Name in the browse sort menu
         defaults to ascending. Three additive migrations (AddLatestDescendantAddedAt,
         AddHomeExcludedLibraries, AddHomeRecentWindowDays); additive API only (new browse sort
         value, reshaped home DTO, new home-libraries endpoint, new prefs field) -> MINOR per
         SemVer 2.0.0. Bugfixes ship as 1.12.x. -->
    <!-- 1.13.0 - additive MINOR over 1.12.0 (Windows-deployment cycle, 2026-09-15). First
         first-class NATIVE WINDOWS distribution alongside the existing containers, 3 lanes +
         2 owner-review blocker lanes: (A) Publish-Windows.ps1 stages a complete self-contained
         win-x64 distribution (server incl. built web assets + worker + bundled loopback-default
         config; data roots default to %LOCALAPPDATA%\MangaPlex; server content root pinned to
         the exe dir on Windows so config/wwwroot/worker resolve regardless of launcher CWD);
         (B) MangaPlex.Tray launcher - owns the server child process (single-file exe, drained
         stdout to a capped rolling log, CTRL_BREAK graceful stop), Open-in-browser, LAN-access
         opt-in (bind passed as a command-line Urls argument: ASPNETCORE_URLS is host-level
         config that the bundled appsettings would override), Set Port dialog with availability
         validation, start-at-sign-in Run key, port auto-resolution around Windows excluded-port
         ranges (default 27272); (C) WiX v6 per-user MSI - no-elevation install to
         %LOCALAPPDATA%\Programs, install-dir picker, launch-after-install, product icons,
         MajorUpgrade preserving the user's autostart choice, same-version upgrades-in-place,
         uninstall preserves user data; (H) platform-aware admin library registration (additive
         SystemInfoDto.Platform; Windows path wording instead of container mount idioms). Server
         code changes are Windows-gated - container/Linux behavior byte-identical (verified).
         Additive API only, no schema change -> MINOR per SemVer 2.0.0. Bugfixes ship as 1.13.x. -->
    <!-- 1.14.0 - additive MINOR over 1.13.0 (public-repository cycle, 2026-09-16). The product
         is renamed from its working title MangaPlex to MangaPixer (all identifiers: namespaces,
         assemblies, database file, config prefix, cookies/CSRF header, image/service/volume
         names, Windows data folder, registry keys, tray + MSI identity with a new UpgradeCode;
         no compatibility shim - the only deployments were the owner's, migrated by hand), and
         the repository goes public on GitHub (dixit92/mangapixer): README, MIT LICENSE,
         THIRD-PARTY-NOTICES with a Windows inventory, CONTRIBUTING, SECURITY, docs/ user
         guides incl. the Windows guide, issue/PR templates, Dependabot, CI (Verify full tier)
         and a tag-triggered release workflow (GHCR image + SBOM + MSI). License notices ship
         in the image and the Windows distribution. Fix: backup/restore validation no longer
         holds the database file open (Windows + bind-mount first-start failure). Git history
         author identity rewritten to the GitHub noreply address before the first push. No
         schema change; additive/renamed API surface only -> MINOR per SemVer 2.0.0. -->
    <!-- 1.14.1 - PATCH over 1.14.0 (2026-09-16), deployment files, docs and release tooling only;
         no app behavior, API or schema change. The Compose files pull the published image from
         ghcr.io/dixit92/mangapixer (build section moved to the compose.build.yaml overlay), the
         install guides and README describe the pull-based install, the release build embeds the
         commit SHA (the 1.14.0 image reported "+dirty"), and the release gate fixes from the
         1.14.0 cut (Linux smoke marker, Verify-Contracts version stage) are recorded. -->
    <!-- 1.15.0 - additive MINOR over 1.14.1 (Correctness and Hardening cycle, 2026-09-17;
         first cycle run in the Unraid dev-container environment alongside the public GitHub
         remote). Five parallel lanes: (A) catalog Name sort is now natural order end to end -
         SortKey.ForNode wired into the scan persist path, a forward-only data-only idempotent
         backfill migration (mp_sort_key SQLite UDF) recomputes existing rows, corrected on
         first upgrade start with no rescan; read-side ordering, DTOs and the
         (ParentId,Kind,SortKey) index unchanged; (B) scanner + reader fixes - skip AppleDouble
         ._* files and __MACOSX dirs, mark solid .cb7/.7z archives Unsupported at persist time
         with an unsupported_solid reader message (no longer falsely ready), case-fold the
         reader help-overlay M/F shortcuts; (C) backend hardening - restore multipart limit
         raised to the configured cap, replaced-* DB files cleaned after a durable swap, keys
         dir created + chmod 700 on first boot, /health (liveness) split from /health/ready
         (DB readiness), dead Logging:LogLevel config removed; (D) changing sort/view/card-size/
         page-size no longer resets HomeRecentWindowDays (web-only); (E) DPI-aware tray Set Port
         dialog + descriptive release asset names. One additive data-only migration
         (BackfillNaturalSortKeys); no breaking API/contract change (OpenAPI snapshot unchanged)
         -> MINOR per SemVer 2.0.0. Bugfixes ship as 1.15.x. -->
    <!-- 1.16.0: "Auth/Session and Reverse-Proxy Hardening". Additive reverse-proxy
         support (ForwardedHeaders middleware with an env-configurable trust list, default
         loopback+private ranges; auth cookies marked Secure when the effective scheme is
         https) plus backward-compatible auth/session correctness fixes: logout now revokes
         the server session row, an admin role change rotates the security stamp, active
         sessions slide instead of hard-expiring at 7 days, restore truly invalidates
         sessions, and the login rate limiter keys on the real client IP with an accurate
         Retry-After and a per-target activation bucket. No new/changed API routes, no DTO
         change, no migration, worker protocol unchanged (OpenAPI snapshot unchanged)
         -> MINOR per SemVer 2.0.0. Bugfixes ship as 1.16.x. -->
    <!-- 1.17.0: "User Management and UX Polish". Additive admin/auth endpoints
         (delete a user with last-admin protection; reissue a pending user's activation
         link) plus a home New-chapters read-state filter, surfaced in-reader bookmarks
         with direction-aware chapter arrows, distinct browse sort icons, a multi-column
         list view, and a per-category debug log-level admin UI. No breaking API/contract
         change, no migration, worker protocol unchanged (still 2)
         -> MINOR per SemVer 2.0.0. Bugfixes ship as 1.17.x. -->
    <!-- 1.18.0: "Backups, Audit and Reader Fixes". Additive MINOR over 1.17.1,
         three lanes. ADMIN: a DB backup restore UI (new admin-only endpoints
         GET operations/backups/files to list on-disk rotating snapshots and POST
         operations/backups/restore to restore a chosen snapshot via the existing
         validate + snapshot + apply-on-restart + rollback path, traversal-guarded)
         plus an admin audit trail (new AuditService write points on user delete /
         activation reissue / password reset / backup restore / logging change, a
         paged GET admin/audit read endpoint, and an admin card) reusing the
         pre-existing audit_events table (no new migration). COLUMNS: a per-user
         selectable list-view column count (1 to 3) reusing the card-size slider
         pattern, persisted as LibraryViewPreferencesDto.ListColumns (one additive
         forward-only column, migration AddListColumns, AddHomeRecentWindowDays
         shape). READERFIX: correct fit-width / fit-height / original image sizing
         in paired double-page spreads, and stop an installed Android PWA zoom
         false-positive from blocking swipe paging (viewport-fit=cover plus a
         widened pinch-zoom threshold; device-verified by the owner post-deploy).
         Additive API only (new endpoints and one optional DTO field); one additive
         forward-only migration -> MINOR per SemVer 2.0.0. Bugfixes ship as 1.18.x. -->
    <!-- 1.19.0: "Image Scaling". Additive MINOR over 1.18.0, three lanes. SCALE-SERVER:
         display-sized page variants - the page endpoint accepts an optional ?maxDim query
         parameter snapped UP to a configurable bucket ladder (default 1080/1440/2160 px
         longest edge, MangaPixer:Media:PageVariants) and served as a Lanczos-downscaled WebP
         with its own cache key (webp@<bucket>); the server never upscales, animated pages keep
         their passthrough, and every page response carries an X-MangaPixer-Variant header.
         One additive optional field on the worker ExtractRequest (MaxDimension, default 0),
         so the worker protocol stays 2. SCALE-CLIENT: the reader requests the size its layout
         box will paint (fit mode, pairing, viewport, devicePixelRatio; URLs pinned per chapter
         so rotation never re-fetches the page on screen), plus two per-device options - Page
         quality (Auto / Full) and Rendering (Smooth / Enhance), where Enhance is an opt-in
         Anime4K WebGPU line-art upscaler drawn on a canvas over the paged <img> only when the
         page is displayed larger than its native size (lazy chunk; no-op without WebGPU;
         webtoon excluded). POLISH: Backups-card Restore button alignment, installed-Android
         standalone-mode document scrollbar, keyboard/focus semantics for clickable elements.
         Also a format-only whitespace fix of 1.17.0-era test debt. Additive API only (one
         optional query parameter, one response header), no migration -> MINOR per SemVer
         2.0.0. Bugfixes ship as 1.19.x. -->
    <!-- 1.19.1 - PATCH over 1.19.0 (2026-09-18), web-only, no API/schema change. The reader's
         Rendering "Enhance" (Anime4K) overlay decided whether a page was being upscaled by
         comparing the painted CSS width with the image's natural width, ignoring
         devicePixelRatio - so on DPR 2-3 phones and tablets a page painted well past its
         native resolution in device pixels read as a "downscale" and the overlay stayed hidden
         (desktop DPR 1 masked it). The gate now compares in device pixels, matching the canvas
         it already rasterized at rect * dpr. Owner-reported on Android + iPad after the 1.19.0
         deploy. -->
    <!-- 1.19.2 - PATCH over 1.19.1 (2026-09-18), web-only, no API/schema change. On iPad and
         iPhone the reader's Fullscreen button now drives the in-page immersive mode instead of
         Safari's Fullscreen API, which painted a persistent system close button and kept the
         status bar over the page; iPadOS Safari's Mac-masquerading identity is detected via the
         touch-point count. The installed home-screen app declares itself (apple-mobile-web-app
         meta tags, opaque black status bar, app title) so it opens without Safari's bars. Owner-
         reported from the 1.19.x iPad test. -->
    <MangaPixerVersionMajor>1</MangaPixerVersionMajor>
    <MangaPixerVersionMinor>19</MangaPixerVersionMinor>
    <MangaPixerVersionPatch>2</MangaPixerVersionPatch>
    <MangaPixerVersionPrerelease></MangaPixerVersionPrerelease>

    <!-- Composed SemVer without build metadata (used for PackageVersion) -->
    <MangaPixerVersion>$(MangaPixerVersionMajor).$(MangaPixerVersionMinor).$(MangaPixerVersionPatch)</MangaPixerVersion>
    <MangaPixerVersionFull Condition="'$(MangaPixerVersionPrerelease)' != ''">$(MangaPixerVersion)-$(MangaPixerVersionPrerelease)</MangaPixerVersionFull>
    <MangaPixerVersionFull Condition="'$(MangaPixerVersionPrerelease)' == ''">$(MangaPixerVersion)</MangaPixerVersionFull>

    <!-- Build counter for FileVersion (numeric only). Defaults to 0 for local builds. -->
    <MangaPixerBuildCounter Condition="'$(MangaPixerBuildCounter)' == ''">0</MangaPixerBuildCounter>

    <!-- AssemblyVersion stays at MAJOR.MINOR.0.0 (1.1.0.0 now) through a minor
         line to avoid binding churn; patch/build vary in FileVersion only. -->
    <MangaPixerAssemblyVersion>$(MangaPixerVersionMajor).$(MangaPixerVersionMinor).0.0</MangaPixerAssemblyVersion>
  </PropertyGroup>
</Project>
