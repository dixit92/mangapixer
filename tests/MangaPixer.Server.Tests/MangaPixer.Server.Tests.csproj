<?xml version="1.0" encoding="utf-8"?>
<!-- MangaPixer.Server.Tests: integration tests for the API server. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MangaPixer.Server\MangaPixer.Server.csproj" />
    <ProjectReference Include="..\..\src\MangaPixer.MediaWorker\MangaPixer.MediaWorker.csproj" />
    <ProjectReference Include="..\MangaPixer.TestSupport\MangaPixer.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recorded MangaUpdates API responses (1.24.0); replayed by a fake handler, never the network. -->
    <EmbeddedResource Include="Features\Metadata\Fixtures\MangaUpdates\*.json" LogicalName="MangaUpdates.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
