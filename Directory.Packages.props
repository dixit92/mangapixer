<?xml version="1.0" encoding="utf-8"?>
<!--
  Directory.Packages.props — Central Package Management (CPM) for MangaPlex.
  All NuGet package versions are pinned here. Individual .csproj files reference
  packages without versions. Update versions only here with advisory review.

  P00: Archive/image packages (SharpCompress, Magick.NET) are NOT referenced yet.
  They are added in P01 after version vetting and compatibility verification.
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core / EF Core / Identity (.NET 10 LTS) -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />

    <!-- Logging provider (Serilog as provider only; domain code uses MEL) -->
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />

    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />

    <!-- Archive and image processing (P01: vetted versions) -->
    <PackageVersion Include="SharpCompress" Version="0.50.4" />
    <PackageVersion Include="Magick.NET-Q8-AnyCPU" Version="14.17.1" />

    <!-- Transitive security pins: override vulnerable transitive versions -->
    <!-- SQLitePCLRaw: use 3.x bundle for FTS5/trigram support and security fixes -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="3.0.5" />
    <!-- Microsoft.OpenApi: pin to a patched version (2.0.0 has GHSA-v5pm-xwqc-g5wc) -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
    <!-- System.Security.Cryptography.Xml 9.0.0 has multiple CVEs; pin to 10.0.11 -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>
</Project>
