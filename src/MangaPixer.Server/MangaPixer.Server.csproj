<?xml version="1.0" encoding="utf-8"?>
<!-- MangaPixer.Server: ASP.NET Core API server. References Core. No native image codecs in this process. -->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Workstation GC (concurrent stays on). The Web SDK defaults to Server GC,
         whose large gen0 budget let an idle server keep ~20 MiB more post-burst
         garbage (measured 1.22.0: idle RSS 248 vs 227 MiB, same burst throughput
         and page latency). A self-hosted reader server runs few concurrent
         requests and does its image work in the worker process, so it gains
         nothing from per-core GC heaps. Override with DOTNET_gcServer=1. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MangaPixer.Server.Tests" />
  </ItemGroup>

  <!-- 1.53.0 "What's new": the repository's CHANGELOG.md is the admins' release notes, embedded so they always match the binary and work
       offline (Features/WhatsNew/WhatsNewNotes.cs). A missing file fails the build (CS1566) instead of shipping a server without notes;
       deploy/Dockerfile copies it into the build stage, the Windows publish builds from the checkout. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="CHANGELOG.md" Link="CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MangaPixer.Core\MangaPixer.Core.csproj" />
    <ProjectReference Include="..\MangaPixer.MediaWorker\MangaPixer.MediaWorker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Use Core + explicit bundle for FTS5/trigram support -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Extensions.Logging" />
  </ItemGroup>
</Project>
