{
  "name": "com.lifepixer.mangapixer.web",
  "version": "1.45.1",
  "description": "MangaPixer Angular web reader",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/precompress.mjs",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint && node scripts/check-theme-colors.mjs --enforce",
    "test": "ng test",
    "test:ci": "ng test",
    "e2e": "npx playwright test",
    "api:check": "node scripts/check-openapi-drift.mjs",
    "theme:check": "node scripts/check-theme-colors.mjs"
  },
  "dependencies": {
    "@angular/animations": "^22.2.1",
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@fontsource/roboto": "^5.1.0",
    "anime4k-webgpu": "^1.0.0",
    "material-icons": "^1.13.12",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.0",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "angular-eslint": "^22.6.0",
    "eslint": "^9.15.0",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.0",
    "vitest": "^4.1.11"
  }
}
