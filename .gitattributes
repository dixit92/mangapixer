# MangaPlex .gitattributes
# Normalize line endings and handle binary files

* text=auto eol=lf

# Source files
*.cs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf

# Solution and project files
*.slnx text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf

# Binary files — no merging or EOL conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.bmp binary
*.tiff binary
*.ico binary
*.woff binary
*.woff2 binary
