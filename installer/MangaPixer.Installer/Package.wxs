<?xml version="1.0" encoding="utf-8"?>
<!--
  MangaPixer per-user MSI installer (WiX v6).

  Install design:
    - Per-user, no elevation: installs under %LOCALAPPDATA%\Programs\MangaPixer,
      all registration under HKCU. Scope="perUser" on the Package element is
      what drives this (ALLUSERS is never set).
    - UpgradeCode below is fixed at authoring time and must NEVER change -
      it is the identity MajorUpgrade uses to detect/replace prior versions.
      It (and the three fixed Component GUIDs below, whose key paths moved
      with the product name) was issued fresh for the MangaPixer name: a
      clean break, so an install made under the earlier working title is
      not an upgrade target and must be uninstalled separately.
    - ProductVersion comes from the build (see Build-Installer.ps1), which
      reads Version.props via Get-MangaPixerVersion.ps1 - never hardcoded here.
    - ProductCode (the MSI's own internal product identity, distinct from
      UpgradeCode) is left to WiX's default per-build generation - Package/@Id
      in WiX v4+ is a stable human-readable package identifier, not a
      ProductCode override slot (the old v3 Id="*"/raw-GUID form no longer
      applies), so it is not set here at all.
    - Uninstall removes only what this package installs (program files under
      INSTALLFOLDER, the Start Menu shortcut, and the Run key). It never
      references %LOCALAPPDATA%\MangaPixer (the app's user-data directory:
      database, settings, covers), so that directory and its contents survive
      uninstall untouched by construction.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="MangaPixer"
            Manufacturer="MangaPixer"
            Version="$(var.ProductVersion)"
            UpgradeCode="7FAC1E1F-38AB-49D1-80A3-D092E1CDFE4D"
            Scope="perUser"
            Compressed="yes">

    <!-- AllowSameVersionUpgrades: a rebuilt MSI carrying the same version
         (routine during a review/test cycle, and a user re-running an
         installer to repair) upgrades over the installed copy instead of
         landing as a confusing side-by-side second product. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of MangaPixer is already installed. To downgrade, first uninstall it from Windows Settings &gt; Apps &gt; MangaPixer, then run this installer again. Your library data is preserved across uninstalls." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Start MangaPixer at sign-in: default ON for a genuinely fresh install,
         but a MajorUpgrade must NOT silently re-enable it for a user who
         turned it off. RegistrySearch runs during AppSearch, which happens
         well before RemoveExistingProducts in the standard sequence - so on
         an upgrade the OLD product's registrations are still on disk when
         these searches run.
           - MANGAPIXERPREVIOUSLYINSTALLED: any prior version of this product
             ever completed an install (the StartMenuShortcut component below
             always writes this marker, so it survives regardless of the
             user's sign-in-autostart choice).
           - MANGAPIXERRUNKEYEXISTS: the sign-in Run key's CURRENT state,
             before this upgrade touches anything.
         RunAtSignInRegistry's Condition below (not this Property alone)
         is what actually decides: fresh install -> RUNATSIGNIN default/
         command-line value; upgrade -> mirror the key's current state,
         ignoring RUNATSIGNIN entirely (an explicit command-line override
         is honored only on a fresh install - see the Component Condition). -->
    <Property Id="RUNATSIGNIN" Value="1" Secure="yes" />
    <Property Id="MANGAPIXERPREVIOUSLYINSTALLED" Secure="yes">
      <RegistrySearch Id="PreviousInstallSearch" Root="HKCU" Key="Software\MangaPixer" Name="StartMenuShortcut" Type="raw" />
    </Property>
    <Property Id="MANGAPIXERRUNKEYEXISTS" Secure="yes">
      <RegistrySearch Id="RunAtSignInSearch" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="MangaPixer" Type="raw" />
    </Property>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="MangaPixer">
          <Directory Id="ServerDir" Name="server" />
          <Directory Id="WorkerDir" Name="worker" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <Icon Id="ProductIcon" SourceFile="..\..\src\MangaPixer.Tray\MangaPixer.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />

    <Feature Id="MainFeature" Title="MangaPixer" Level="1" AllowAbsent="no" AllowAdvertise="no">
      <ComponentGroupRef Id="ServerComponents" />
      <ComponentGroupRef Id="WorkerComponents" />
      <ComponentRef Id="TrayExeComponent" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="RunAtSignInRegistry" />
    </Feature>

    <!-- Harvested at build time from the staged Windows distribution folder
         (server + worker binaries, tray exe, bundled config). See
         Build-Installer.ps1 for how PayloadDir is supplied. Split into two
         scoped harvests (server\, worker\) plus one explicit <File> for the
         tray exe, instead of one glob over the whole payload root, so the
         tray exe gets a stable File Id ("TrayExe") - the harvested-file Ids
         <Files> assigns are content-hashed, not stable/predictable, and
         WixShellExec (see LaunchApplication below) needs a fixed Id to
         target. Installed paths are unchanged: server\ and worker\ trees
         land exactly where they did under the single glob, and the tray exe
         still lands at the INSTALLFOLDER root. -->
    <ComponentGroup Id="ServerComponents" Directory="ServerDir">
      <Files Include="$(var.PayloadDir)\server\**\*.*" />
    </ComponentGroup>
    <ComponentGroup Id="WorkerComponents" Directory="WorkerDir">
      <Files Include="$(var.PayloadDir)\worker\**\*.*" />
    </ComponentGroup>
    <Component Id="TrayExeComponent" Directory="INSTALLFOLDER" Guid="C822D8F1-4159-4ED9-85FF-C173C5D85BEE">
      <File Id="TrayExe" Source="$(var.PayloadDir)\MangaPixer.Tray.exe" KeyPath="yes" />
    </Component>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="0F659A35-C538-460F-B288-3F3B766471C8">
      <Shortcut Id="MangaPixerStartMenuShortcut"
                Name="MangaPixer"
                Description="Open MangaPixer"
                Target="[INSTALLFOLDER]MangaPixer.Tray.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="ProductIcon" />
      <RegistryValue Root="HKCU" Key="Software\MangaPixer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="RunAtSignInRegistry" Directory="INSTALLFOLDER" Guid="89C5838C-A115-48C7-822D-D96179E2B006" Condition='(NOT MANGAPIXERPREVIOUSLYINSTALLED AND RUNATSIGNIN = "1") OR (MANGAPIXERPREVIOUSLYINSTALLED AND MANGAPIXERRUNKEYEXISTS)'>
      <RegistryValue Root="HKCU"
                      Key="Software\Microsoft\Windows\CurrentVersion\Run"
                      Name="MangaPixer"
                      Type="string"
                      Value="&quot;[INSTALLFOLDER]MangaPixer.Tray.exe&quot;"
                      KeyPath="yes" />
    </Component>

    <!-- Launch-after-install: the exit-dialog optional checkbox, wired via
         the Util extension's WixShellExec custom action against the stable
         "TrayExe" File Id above. A literal "[INSTALLFOLDER]..." Property
         value is rejected by the compiler as an illegal property reference,
         so WixShellExecTarget is set via a formatted-text CustomAction
         (type 51) instead of a plain Property element - that CustomAction
         only stores the raw "[#TrayExe]" text; WixShellExec itself resolves
         it to the installed path at runtime. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start MangaPixer now" />

    <CustomAction Id="SetLaunchApplicationTarget" Property="WixShellExecTarget" Value="[#TrayExe]" />
    <CustomAction Id="LaunchApplication" BinaryRef="Wix4UtilCA_X86" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />

    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="SetLaunchApplicationTarget" Order="1" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Order="2" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <ui:WixUI Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

  </Package>
</Wix>
